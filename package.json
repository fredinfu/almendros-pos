{
  "name": "almendros-pos",
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "catalog:seed": "node scripts/catalog-seed.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src tests",
    "test:e2e": "playwright test",
    "preview": "http-server dist/almendros-pos/browser -p 4173 -c-1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "dexie": "^4.2.0",
    "zod": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "http-server": "^14.1.1",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
